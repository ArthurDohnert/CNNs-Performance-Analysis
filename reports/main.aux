\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Predictive Performance}{5}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Validation Accuracy vs. Epoch. Medium-weight models (ResNet34, InceptionV3) show stable convergence, while heavyweight models (ResNet101, DenseNet121) fail to reach competitive accuracy within the time limit.}}{5}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:acc_vs_epoch}{{1}{5}{Validation Accuracy vs. Epoch. Medium-weight models (ResNet34, InceptionV3) show stable convergence, while heavyweight models (ResNet101, DenseNet121) fail to reach competitive accuracy within the time limit}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Validation F1-Score vs. Epoch. The trends mirror accuracy, confirming that the successful models are not just predicting majority classes but maintaining balanced precision and recall.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:f1_vs_epoch}{{2}{6}{Validation F1-Score vs. Epoch. The trends mirror accuracy, confirming that the successful models are not just predicting majority classes but maintaining balanced precision and recall}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Training Stability and Variance}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Total Training Time per Seed. Most models show negligible variance, validating the stability of the Guix environment. EfficientNet-B7 is a notable outlier.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:time_per_seed}{{3}{6}{Total Training Time per Seed. Most models show negligible variance, validating the stability of the Guix environment. EfficientNet-B7 is a notable outlier}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distribution of Total Training Time per Model. The boxplot highlights the extreme variance in EfficientNet-B7 compared to the tight clustering of other architectures.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:time_boxplot}{{4}{7}{Distribution of Total Training Time per Model. The boxplot highlights the extreme variance in EfficientNet-B7 compared to the tight clustering of other architectures}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Computational Cost}{7}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Average Total Training Time. There is an order-of-magnitude difference between lightweight models (<5000s) and heavyweight models (>80000s).}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:time_bar}{{5}{7}{Average Total Training Time. There is an order-of-magnitude difference between lightweight models (<5000s) and heavyweight models (>80000s)}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Average Inference Time. Larger models have longer inference times, reflecting their increased complexity.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:inference}{{6}{8}{Average Inference Time. Larger models have longer inference times, reflecting their increased complexity}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces GPU Temperature vs. Epoch. Temperatures remain stable (60-65°C) across all models, indicating effective cooling.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:temp}{{7}{9}{GPU Temperature vs. Epoch. Temperatures remain stable (60-65°C) across all models, indicating effective cooling}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces GPU Utilization vs. Epoch. Most models maintain high utilization (>80\%), though dips are visible in models with lighter computational loads.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:util}{{8}{9}{GPU Utilization vs. Epoch. Most models maintain high utilization (>80\%), though dips are visible in models with lighter computational loads}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces GPU VRAM Usage vs. Epoch. EfficientNet-B7 and VGG16 saturate the 24GB buffer, while lightweight models use <5GB.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:vram}{{9}{10}{GPU VRAM Usage vs. Epoch. EfficientNet-B7 and VGG16 saturate the 24GB buffer, while lightweight models use <5GB}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Total Energy Consumption per Model. Models with the most accuracy consume the most energy.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:energy}{{10}{10}{Total Energy Consumption per Model. Models with the most accuracy consume the most energy}{figure.caption.11}{}}
