\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Validation Accuracy Distribution per Category. The "Heavy" category shows a wide spread due to the failure of ResNet101/DenseNet121 contrasting with the success of InceptionV4.}}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:cat_acc_dist}{{11}{11}{Validation Accuracy Distribution per Category. The "Heavy" category shows a wide spread due to the failure of ResNet101/DenseNet121 contrasting with the success of InceptionV4}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Average Final Accuracy per Category. Medium-weight models offer the highest average performance.}}{12}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cat_acc_mean}{{12}{12}{Average Final Accuracy per Category. Medium-weight models offer the highest average performance}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Efficiency Score (Accuracy per Second). Lightweight models dominate this metric, offering the best return on computational investment.}}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cat_eff}{{13}{12}{Efficiency Score (Accuracy per Second). Lightweight models dominate this metric, offering the best return on computational investment}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Average Training Time per Category. The cost penalty for moving from Medium to Heavy is substantial.}}{13}{figure.caption.15}\protected@file@percent }
\newlabel{fig:cat_time}{{14}{13}{Average Training Time per Category. The cost penalty for moving from Medium to Heavy is substantial}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Global Trade-offs: The Efficiency Frontier}{14}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Accuracy vs. Training Cost (Efficiency Frontier). The optimal models lie on the top-left boundary.}}{14}{figure.caption.16}\protected@file@percent }
\newlabel{fig:frontier}{{15}{14}{Accuracy vs. Training Cost (Efficiency Frontier). The optimal models lie on the top-left boundary}{figure.caption.16}{}}
